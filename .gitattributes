# Linguist overrides

# .NET build outputs
bin/** linguist-generated
obj/** linguist-generated

# CMake build directories
cmake-build-debug/** linguist-generated
cmake-build-release/** linguist-generated

# Gradle build outputs and wrapper
.gradle/** linguist-generated
gradlew linguist-generated
gradlew.bat linguist-generated

# IDE metadata — JetBrains
.idea/** linguist-vendored

# Bundled third-party libraries
**/wwwroot/lib/** linguist-vendored

# Vendored JAR dependencies
*.jar linguist-vendored

# --- Build system files — exclude from language stats ---
# CMake
*.cmake linguist-vendored
CMakeLists.txt linguist-vendored

# MSBuild project/props/targets files
*.csproj linguist-vendored
*.fsproj linguist-vendored
*.vbproj linguist-vendored
*.vcxproj linguist-vendored
*.props linguist-vendored
*.targets linguist-vendored
*.sln linguist-vendored
*.slnx linguist-vendored

# Makefile and Ninja (generated by CMake)
Makefile linguist-vendored
*.ninja linguist-generated

# Gradle build scripts
build.gradle linguist-vendored
settings.gradle linguist-vendored
gradle.properties linguist-vendored

# EditorConfig — project tooling, not source
.editorconfig linguist-vendored

# --- Language overrides ---
# XAML is markup for WPF UI — ensure it's detectable
*.xaml linguist-language=XAML

# Razor views
*.cshtml linguist-language=HTML+Razor
